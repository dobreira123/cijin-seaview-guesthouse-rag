## Copy this file to .env and fill in your own settings. Never upload .env to GitHub.
## Both models must speak the OpenAI-compatible API. The chat model must support tool calling.

## ===== PART 1: the chat model (it chooses the tools and writes the answer) =====

## Ollama (local, no key needed) - used for the screenshots and tests in the report
LLM_API_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5:14b
API_KEY=ollama

## NKUST AI Hub
# LLM_API_URL=https://www.iai.nkust.edu.tw/aihub/v1/
# MODEL_NAME=Furen-large
# API_KEY=

## Gemini
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=gemini-3.5-flash-lite
# API_KEY=

## ===== PART 2: the embedding model (turns text into numbers for the RAG search) =====
## Leave a value empty to use the same server and key as PART 1.

## Ollama (run "ollama pull bge-m3" first; it understands Chinese and English)
EMBEDDING_API_URL=http://localhost:11434/v1
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_API_KEY=ollama

## NKUST AI Hub
# EMBEDDING_API_URL=https://www.iai.nkust.edu.tw/aihub/v1/
# EMBEDDING_MODEL_NAME=Embedding
# EMBEDDING_API_KEY=

## Gemini
# EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_MODEL_NAME=gemini-embedding-001
# EMBEDDING_API_KEY=
